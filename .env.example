# Central Annotation Web Platform & API Configuration
APP_ENV=production
APP_SECRET_KEY=change-this-in-production-to-a-secure-random-key
PUBLIC_BASE_URL=http://192.168.1.103:8080
ALLOWED_ORIGINS=http://192.168.1.103:8080,http://localhost:8080,http://127.0.0.1:8080
CONTROLLER_PORT=8080

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=annotation_db
POSTGRES_USER=annotation_user
POSTGRES_PASSWORD=your_secure_password
DATABASE_URL=postgresql://annotation_user:your_secure_password@postgres:5432/annotation_db

# Initial Admin Bootstrap Token
BOOTSTRAP_ADMIN_TOKEN=your_secure_bootstrap_token

# Batching & Lease Configuration
DEFAULT_BATCH_SIZE=100
MAX_ASSIGNMENT_COUNT=10000
HEARTBEAT_INTERVAL_SECONDS=30
LEASE_DURATION_SECONDS=120
LEASE_GRACE_SECONDS=60

# File & NAS Configuration
SUPPORTED_IMAGE_EXTENSIONS=jpg,jpeg,png,bmp,webp,tif,tiff
EXCLUDED_PATTERNS=.Trash/**,**/.Trash/**,**/.DS_Store,**/.thumbnails/**,**/tmp/**
DEFAULT_REMOTE_NAME=annotation_nas
DATASET_ROOT=ai_data_collection
ANNOTATION_WORKSPACE_ROOT=ai_annotation/workspaces
ANNOTATION_OUTPUT_POLICY=WORKSPACE

# Rclone Configuration
RCLONE_CONFIG_PATH=/secrets/rclone.conf
RCLONE_BIN=rclone
RCLONE_TRANSFERS=2
RCLONE_CHECKERS=2
RCLONE_SFTP_CONCURRENCY=2
RCLONE_BANDWIDTH=25M
RCLONE_TIMEOUT=30s
RCLONE_CONNECT_TIMEOUT=10s
TRANSFER_TIMEOUT_SECONDS=1800

MAX_UPLOAD_SIZE_BYTES=10485760
STAGING_MAX_DISK_PERCENT=90

# Production NAS Direct Credentials (SFTP / SMB)
NAS_STORAGE_TYPE=sftp
NAS_HOST=192.168.1.178
NAS_PORT=2222
NAS_USER=Annotation
NAS_PASSWORD=your_nas_password
NAS_KEY_FILE=
NAS_ROOT_PATH=
